# ============================================================================
# Переменные окружения. На Railway задаются в Variables проекта, локально —
# в файле .env (он в .gitignore и никогда не коммитится).
#
# Колонка «без неё»: что именно перестаёт работать, если переменную не задать.
# Приложение спроектировано на мягкую деградацию — оно поднимется с пустым
# окружением, но половина экранов будет пустой. Единственное исключение —
# APP_PASSWORD, см. ниже.
# ============================================================================

# --- ДОСТУП В ПРИЛОЖЕНИЕ ----------------------------------------------------

# 🔴 ОБЯЗАТЕЛЬНО. Пароль на всё приложение (Basic Auth).
# ⚠️ Если переменная НЕ задана, приложение открыто без пароля кому угодно,
#    кто знает адрес. Это не «функция не работает» — это открытая дверь.
#    Задать до первого деплоя.
APP_PASSWORD=

# Пары «логин:пароль:Имя:email» через запятую — заводят пользователей при старте.
# Нужны, чтобы система знала, КТО именно утвердил текст и запустил волну
# (это пишется в журнал и в поле approved_by).
# Пример: APP_USERS="natasha:secret:Natasha:n@example.com"
# Без неё: работает общий вход по APP_PASSWORD, автор действий — «panel user».
APP_USERS=

# Публичный адрес приложения — подставляется в ссылки внутри Telegram-пингов.
# Без неё: ссылки строятся по хосту запроса (обычно тоже верно).
APP_PUBLIC_URL=

# 🔴 ОБЯЗАТЕЛЬНО, если настраиваются вебхуки. Случайная строка (20+ символов).
# Вебхуки провайдеров идут в обход пароля и защищены только этим секретом:
#   POST /api/webhooks/getsales?secret=<WEBHOOK_SECRET>
#   POST /api/webhooks/smartlead?secret=<WEBHOOK_SECRET>
# Без неё: приёмник отвечает 401 на всё — события провайдеров не доходят.
WEBHOOK_SECRET=

# --- БАЗА ДАННЫХ ------------------------------------------------------------

# Postgres. На Railway подставляется автоматически при добавлении плагина
# Postgres — руками задавать не нужно.
# Без неё: нет реестра, нет кампаний, нет истории — приложение почти пустое.
DATABASE_URL=

# Локальная разработка без Postgres: LOCAL_DB=1 поднимает встроенную PGlite
# в каталоге .localdb. Используется скриптом `npm run dev:local`.
# На проде НЕ задавать.
LOCAL_DB=

# --- LLM --------------------------------------------------------------------

# 🔴 ЗАМЕНИТЬ НА СВОЙ. Ключ Anthropic (console.anthropic.com).
# Питает: генерацию поисковых углов, классификатор ответов, драфтеры текстов,
# подсказки в Inbox, разбор индустрий.
# Без него: все LLM-функции отключены, поиск и рассылка работают.
ANTHROPIC_API_KEY=

# --- ПОИСК КОНТАКТОВ --------------------------------------------------------

# Explee (api.explee.com) — семантический поиск людей и компаний, обогащение адресов.
# ⚠️ ПОИСК БЕСПЛАТЕН ТОЛЬКО В ПРЕДЕЛАХ 100 РЕЗУЛЬТАТОВ НА НАБОР ФИЛЬТРОВ. Результат 101
#    и далее — 1 кредит за строку. У нас на этом за один день сгорел почти весь баланс.
#    Объём берётся числом углов (у каждого своя бесплатная сотня), а не глубиной страниц.
#    Правило и замки — HANDOVER.md §3 и шапка angles.js. Не снимай, не прочитав.
# ⚠️ На НУЛЕВОМ балансе перестаёт работать и бесплатный поиск — Explee требует
#    положительный баланс для любого запроса.
# Без него: панель поиска не возвращает результатов.
EXPLEE_API_KEY=

# Apollo (apollo.io) — второй источник поиска + раскрытие контактов кредитами.
# Без него: не работает Apollo-поиск, Apollo-total (индикатор ширины сегмента)
# и добор контактов (top-up).
APOLLO_API_KEY=

# Serper (serper.dev) — веб-поиск для проверки «уникальной детали» о человеке.
# Без него: поле Unique detail не заполняется.
SERPER_API_KEY=

# MillionVerifier — проверка существования email-адресов.
# Без него: адреса идут в рассылку непроверенными (растёт доля отскоков).
MILLIONVERIFIER_API_KEY=

# --- КАНАЛЫ ОТПРАВКИ --------------------------------------------------------

# 🔴 ЗАМЕНИТЬ НА СВОЙ. GetSales (amazing.getsales.io) — канал LinkedIn.
# ⚠️ Токен привязан к КОМАНДЕ в GetSales, а не к одному профилю. Токен чужой
#    команды = заявки уйдут с ЧУЖИХ LinkedIn-профилей, и отозвать их без следа
#    нельзя. Нужен свой аккаунт/команда со своим профилем.
# Без него: LinkedIn-канал недоступен целиком.
GETSALES_API_TOKEN=

# Smartlead (server.smartlead.ai) — канал email. Тариф Pro и выше (с него API).
# ⚠️ Токен даёт доступ к пулу ящиков того аккаунта. Чужой токен = письма уйдут
#    с чужих доменов.
# Без него: email-канал недоступен, вкладка Campaigns работает только по LinkedIn.
SMARTLEAD_API_KEY=

# --- CRM --------------------------------------------------------------------

# Kommo — источник стоп-листа «кому уже писали / кто уже тёплый».
# Без него: барьер CRM молчит. Приложение работает, но защита остаётся только
# от собственного реестра — тех, кого касалась ЭТА система. Всё, что живёт
# в другой системе (Notion, ATS, таблица), барьеру невидимо.
# См. раздел 4 в HANDOVER.md — это самая заметная дырка в защите.
KOMMO_API_TOKEN=

# --- ОПОВЕЩЕНИЯ -------------------------------------------------------------

# 🔴 ЗАМЕНИТЬ НА СВОЙ. Бот создаётся у @BotFather в Telegram за две минуты.
# Без него: пинги о новых ответах и алерты пишутся только в лог сервера.
TELEGRAM_BOT_TOKEN=

# Кому шлём пинги — chat_id через запятую (несколько получателей поддерживаются).
# Свой chat_id: написать боту любое сообщение, затем открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Кому шлём технические алерты (сбои отправки, расхождения с провайдером).
# Без неё: админом считается первый из TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_CHAT_ID=

# --- СРЕДА (задаёт Railway сам, руками не нужно) ----------------------------
# PORT=
# API_PORT=
# NODE_ENV=
# RAILWAY_ENVIRONMENT=
